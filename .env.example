# Tally: settings needed to run the app.
# Copy to a file named .env (never commit it) and fill in your own values,
# or set these as environment variables (Render, Docker: --env-file .env).
# For local dotnet runs, use user secrets with ":" instead of "__"
#   e.g. dotnet user-secrets set "PayPal:ClientId" "<value>"

# -- Database (SQL Server / Azure SQL) --
ConnectionStrings__TallyDb=Server=localhost,1433;Database=Tally;User Id=sa;Password=<local-password>;TrustServerCertificate=True

# -- PayPal (Sandbox): developer.paypal.com -> Apps & Credentials --
PayPal__BaseUrl=https://api-m.sandbox.paypal.com
PayPal__ClientId=<your-sandbox-client-id>
PayPal__ClientSecret=<your-sandbox-client-secret>
PayPal__WebhookId=<your-sandbox-webhook-id>

# -- AI (Azure OpenAI via Semantic Kernel) --
Ai__Provider=<provider, e.g. AzureOpenAI>
Ai__Endpoint=https://<your-resource>.openai.azure.com/
Ai__Deployment=<your-deployment-name, e.g. gpt-4o-mini>
Ai__ApiKey=<your-azure-openai-key>

# -- Webhook queue (optional): leave empty to use the in-memory queue --
ServiceBus__ConnectionString=

# -- Demo mode --
Demo__Enabled=true
Demo__PayerEmail=<a PayPal sandbox personal account email: receives the demo bills>
Demo__MeeraPaidInvoiceId=<optional: an already-paid sandbox invoice id>
Demo__LakshmiPaidInvoiceId=<optional: an already-paid sandbox invoice id>
# Demo__IdleResetMinutes=30   (optional, default 30; 0 = never reset by itself)

# -- Academy --
Academy__Name=Melody Music Academy

# -- Frontend (build time): AG Grid Enterprise license --
VITE_AG_GRID_LICENSE_KEY=<your-ag-grid-license-key>
